# Postgres
DATABASE_URL=postgres://taskmaster:taskmaster@localhost:5432/taskmaster

# Organization defaults (V1 assumes a single organization row, seeded by migration/admin bootstrap)
ORG_ID=00000000-0000-0000-0000-000000000001
ORG_TIMEZONE=America/New_York
ORG_DEFAULT_REMINDER_TIME=09:00
ORG_DEFAULT_CUTOFF_TIME=16:00
ORG_DEFAULT_DIGEST_PUBLISH_TIME=17:00

# HTTP
API_PORT=3978
ADMIN_PORT=3979

# teams-adapter: local simulation mode only in V1 vertical slice.
# Set to "local-sim" until a real Teams SDK client (Microsoft 365 Agents SDK / @microsoft/teams.*) is wired up.
TEAMS_ADAPTER_MODE=local-sim

# jira-integration: fake adapter only in V1 vertical slice.
JIRA_ADAPTER_MODE=fake

# Scheduler
SCHEDULER_TICK_INTERVAL_MS=15000

# Logging / OTel
LOG_LEVEL=info
OTEL_SERVICE_NAME=taskmaster

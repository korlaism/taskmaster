# Postgres
DATABASE_URL=postgres://taskmaster:taskmaster@localhost:5432/taskmaster

# Organization defaults (V1 assumes a single organization row, seeded by migration/admin bootstrap)
ORG_ID=00000000-0000-0000-0000-000000000001
ORG_TIMEZONE=America/New_York
ORG_DEFAULT_REMINDER_TIME=09:00
ORG_DEFAULT_CUTOFF_TIME=16:00
ORG_DEFAULT_DIGEST_PUBLISH_TIME=17:00

# HTTP
API_PORT=3978
ADMIN_PORT=3979

# --- teams-adapter ---
# "local-sim" (default): no live tenant needed, see docs/10-local-development.md.
# "live": real Teams delivery via @microsoft/teams.apps. Requires an Entra app
# registration + Azure Bot resource — see docs/02-teams-permissions-and-installation.md
# for the exact steps. Never live-tested while building this (docs/00) — verify during
# your own registration.
TEAMS_ADAPTER_MODE=local-sim
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=

# --- jira-integration ---
# "fake" (default): seeded fixture data, no real Jira needed.
# "live": real Jira Cloud REST API v3 against JIRA_BASE_URL, authenticated as a
# dedicated service account (email + API token — see docs/03-jira-authentication-plan.md).
# Generate the token at https://id.atlassian.com/manage-profile/security/api-tokens.
JIRA_ADAPTER_MODE=fake
JIRA_BASE_URL=https://simnovus.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Shared secret compared against the Jira webhook's `?token=` query param — classic
# Jira Cloud webhooks don't sign requests the way GitHub does; see docs/03.
JIRA_WEBHOOK_SECRET=

# --- git-integration ---
# "none" (default): no Git provider wired up.
# "github": real GitHub REST API v3, authenticated via a personal access token
# (see docs/04-git-provider-integration-plan.md). Live-validated against a real repo
# while building this adapter.
GIT_PROVIDER_MODE=none
GITHUB_TOKEN=
# comma-separated "owner/repo" list this org tracks, e.g. gauravsimnovus/taskmaster
GITHUB_REPOS=
GITHUB_WEBHOOK_SECRET=

# Scheduler
SCHEDULER_TICK_INTERVAL_MS=15000

# Logging / OTel
LOG_LEVEL=info
OTEL_SERVICE_NAME=taskmaster
